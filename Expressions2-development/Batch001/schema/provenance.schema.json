{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/provenance.schema.json",
  "title": "Koto Expressions2 family provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenanceId", "familyId", "candidateIds", "sourceSnapshots", "fieldDerivations", "compiler", "review", "inputDigest", "outputDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provenanceId": { "type": "string", "pattern": "^provenance2:[0-9a-f]{32}$" },
    "familyId": { "$ref": "common.schema.json#/$defs/familyId" },
    "candidateIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/candidateId" } },
    "sourceSnapshots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["sourceId", "sha256"],
        "properties": {
          "sourceId": { "$ref": "common.schema.json#/$defs/sourceId" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "fieldDerivations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["jsonPointer", "method", "evidence", "criticStatus"],
        "properties": {
          "jsonPointer": { "type": "string", "pattern": "^/" },
          "method": { "enum": ["source-extract", "deterministic-transform", "editorial-synthesis", "classifier", "constraint-compiler"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } },
          "criticStatus": { "const": "passed" }
        }
      }
    },
    "compiler": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "configurationDigest"],
      "properties": {
        "name": { "const": "koto-expressions2-family" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "configurationDigest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "review": { "$ref": "common.schema.json#/$defs/review" },
    "inputDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "outputDigest": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
