{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/runtime-library-index.schema.json",
  "title": "Koto Expressions2 runtime Library index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "publicationStatus", "familyCount", "formCount", "categories", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "const": "0.1.0-development" },
    "publicationStatus": { "const": "shadow-candidate" },
    "familyCount": { "const": 100 },
    "formCount": { "type": "integer", "minimum": 100 },
    "categories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["key", "label", "count"],
        "properties": {
          "key": { "$ref": "common.schema.json#/$defs/slug" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "entries": {
      "type": "array", "minItems": 100, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["familyId", "slug", "pack", "difficulty", "category", "japanese", "reading", "contextualMeaning", "intentions", "usageContexts", "searchText", "formCount", "verifiedSourceState", "availableActions"],
        "properties": {
          "familyId": { "$ref": "common.schema.json#/$defs/familyId" },
          "slug": { "$ref": "common.schema.json#/$defs/slug" },
          "pack": { "enum": ["family-pack-01", "family-pack-02", "family-pack-03", "family-pack-04"] },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "category": {
            "type": "object", "additionalProperties": false, "required": ["key", "label"],
            "properties": { "key": { "$ref": "common.schema.json#/$defs/slug" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 } }
          },
          "japanese": { "$ref": "common.schema.json#/$defs/japanese" },
          "reading": { "$ref": "common.schema.json#/$defs/reading" },
          "contextualMeaning": { "type": "string", "minLength": 1, "maxLength": 600 },
          "intentions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "usageContexts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
          "searchText": { "type": "string", "minLength": 1 },
          "formCount": { "type": "integer", "minimum": 1 },
          "verifiedSourceState": { "const": "verified" },
          "availableActions": { "const": ["recognised", "review", "open"] }
        }
      }
    }
  }
}
