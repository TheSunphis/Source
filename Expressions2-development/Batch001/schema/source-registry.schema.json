{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/source-registry.schema.json",
  "title": "Koto Expressions2 source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetDatasetLicense", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "targetDatasetLicense": { "const": "CC-BY-SA-4.0" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId", "name", "owner", "canonicalUrl", "acquisitionUrl", "networkPolicy",
        "roles", "permissionClass", "approvalStatus", "license", "allowed",
        "thirdPartyContentRisk", "notes", "snapshot"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^source2:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "acquisitionUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedHosts", "maxBytes", "expectedBytes", "expectedSha256"],
          "properties": {
            "allowedHosts": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
            },
            "maxBytes": { "type": "integer", "minimum": 1 },
            "expectedBytes": { "type": ["integer", "null"], "minimum": 1 },
            "expectedSha256": {
              "oneOf": [
                { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                { "type": "null" }
              ]
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "candidate-forms", "readings", "lexical-senses", "attestation",
              "pattern-evidence", "semantic-grouping", "duplicate-detection",
              "morphology", "morphology-runtime", "canonical-vocabulary", "register-evidence"
            ]
          }
        },
        "permissionClass": {
          "enum": ["redistributable", "evidence-only", "tool-only", "prohibited", "pending"]
        },
        "approvalStatus": {
          "enum": ["proposed", "approved-for-snapshot", "approved", "rejected", "suspended"]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "commercialUse", "redistribution", "shareAlike", "attribution", "notes"],
          "properties": {
            "name": { "$ref": "#/$defs/nonEmpty" },
            "url": { "type": "string", "format": "uri" },
            "commercialUse": { "type": ["boolean", "null"] },
            "redistribution": { "type": ["boolean", "null"] },
            "shareAlike": { "type": ["boolean", "null"] },
            "attribution": { "$ref": "#/$defs/nonEmpty" },
            "notes": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "allowed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machineAccess", "modelProcessing", "redistributeRaw", "redistributeExtracts", "publishDerivedRecords"],
          "properties": {
            "machineAccess": { "type": "boolean" },
            "modelProcessing": { "type": "boolean" },
            "redistributeRaw": { "type": "boolean" },
            "redistributeExtracts": { "type": "boolean" },
            "publishDerivedRecords": { "type": "boolean" }
          }
        },
        "thirdPartyContentRisk": { "enum": ["low", "medium", "high", "unknown"] },
        "notes": { "$ref": "#/$defs/nonEmpty" },
        "snapshot": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["versionOrDate", "retrievedAt", "byteLength", "sha256", "mediaType"],
              "properties": {
                "versionOrDate": { "$ref": "#/$defs/nonEmpty" },
                "retrievedAt": { "type": "string", "format": "date-time" },
                "byteLength": { "type": "integer", "minimum": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "mediaType": { "$ref": "#/$defs/nonEmpty" }
              }
            }
          ]
        }
      }
    }
  }
}
