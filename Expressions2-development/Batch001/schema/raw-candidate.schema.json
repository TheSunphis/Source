{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/raw-candidate.schema.json",
  "title": "Koto Expressions2 raw source-derived candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rawCandidateId", "channel", "surface", "reading", "sourceEvidence", "extractor", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rawCandidateId": { "type": "string", "pattern": "^rawcandidate2:[0-9a-f]{32}$" },
    "channel": { "enum": ["labelled-expression", "wiktionary-structural", "multiword-lexical", "corpus-ngram", "grammar-construction", "collocation", "interactional-formula", "institutional-formula"] },
    "surface": { "$ref": "common.schema.json#/$defs/japanese" },
    "reading": { "oneOf": [{ "$ref": "common.schema.json#/$defs/reading" }, { "type": "null" }] },
    "sourceEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } },
    "extractor": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "sourceSnapshotSha256", "ruleId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sourceSnapshotSha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
