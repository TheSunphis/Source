{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/compiler-manifest.schema.json",
  "title": "Koto Expressions2 Batch 001 deterministic compiler manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildId", "release", "publicationStatus", "productionReady", "sourceDateEpoch", "inputs", "counts", "coverage", "artifacts", "determinism", "incrementalBuild"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "buildId": { "type": "string", "pattern": "^build2:[0-9a-f]{32}$" },
    "release": { "const": "0.1.0-development" },
    "publicationStatus": { "const": "shadow-candidate" },
    "productionReady": { "const": false },
    "sourceDateEpoch": { "type": "integer", "minimum": 0 },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "id", "sha256"],
        "properties": {
          "kind": { "enum": ["source-snapshot", "schema", "configuration", "candidate-ledger", "vocabulary-index"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 500 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["normalizedCandidates", "acceptedFamilies", "publishedForms", "analysisRecords", "familyPacks", "familiesPerPack"],
      "properties": {
        "normalizedCandidates": { "type": "integer", "minimum": 2000 },
        "acceptedFamilies": { "const": 100 },
        "publishedForms": { "type": "integer", "minimum": 100 },
        "analysisRecords": { "type": "integer", "minimum": 100 },
        "familyPacks": { "const": 4 },
        "familiesPerPack": { "const": 25 }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["classCounts", "difficultyCounts", "documentedDeviations"],
      "properties": {
        "classCounts": {
          "type": "object", "additionalProperties": false,
          "required": ["interactional-formula", "discourse-routine", "grammar-construction", "conventional-collocation", "idiom", "proverb-or-saying", "institutional-formula", "productive-sentence-frame", "pragmatic-pattern"],
          "properties": {
            "interactional-formula": { "type": "integer", "minimum": 0 }, "discourse-routine": { "type": "integer", "minimum": 0 },
            "grammar-construction": { "type": "integer", "minimum": 0 }, "conventional-collocation": { "type": "integer", "minimum": 0 },
            "idiom": { "type": "integer", "minimum": 0 }, "proverb-or-saying": { "type": "integer", "minimum": 0 },
            "institutional-formula": { "type": "integer", "minimum": 0 }, "productive-sentence-frame": { "type": "integer", "minimum": 0 },
            "pragmatic-pattern": { "type": "integer", "minimum": 0 }
          }
        },
        "difficultyCounts": {
          "type": "object", "additionalProperties": false, "required": ["1", "2", "3", "4", "5"],
          "properties": { "1": { "type": "integer", "minimum": 0 }, "2": { "type": "integer", "minimum": 0 }, "3": { "type": "integer", "minimum": 0 }, "4": { "type": "integer", "minimum": 0 }, "5": { "type": "integer", "minimum": 0 } }
        },
        "documentedDeviations": { "type": "array", "items": { "type": "string", "minLength": 20 } }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "kind", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "kind": { "enum": ["library-index", "family-pack", "analysis-pack", "source-attribution", "audit-manifest", "provenance-pack"] },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "determinism": {
      "type": "object", "additionalProperties": false, "required": ["canonicalJson", "stableOrdering", "secondCleanBuildMatched"],
      "properties": {
        "canonicalJson": { "const": true },
        "stableOrdering": { "const": true },
        "secondCleanBuildMatched": { "const": true }
      }
    },
    "incrementalBuild": {
      "type": "object", "additionalProperties": false, "required": ["contentAddressedCache", "changedOnlySupported"],
      "properties": {
        "contentAddressedCache": { "const": true },
        "changedOnlySupported": { "const": true }
      }
    }
  }
}
