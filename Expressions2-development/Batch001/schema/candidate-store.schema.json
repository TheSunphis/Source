{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/candidate-store.schema.json",
  "title": "Koto Expressions2 candidate store",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "records"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "raw" },
        "records": { "type": "array", "minItems": 1, "items": { "$ref": "raw-candidate.schema.json" } }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "records"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "kind": { "const": "normalized" },
        "records": { "type": "array", "minItems": 2000, "items": { "$ref": "candidate.schema.json" } }
      }
    }
  ]
}
