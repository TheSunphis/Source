{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/family-ledger.schema.json",
  "title": "Koto Expressions2 append-only family decision ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerId", "createdAt", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ledgerId": { "type": "string", "pattern": "^ledger2:[0-9a-f]{32}$" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "events": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sequence", "eventId", "candidateIds", "familyId", "action", "reasonCodes", "explanation", "evidence", "actor", "occurredAt", "previousEventHash"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "eventId": { "type": "string", "pattern": "^ledgerevent2:[0-9a-f]{32}$" },
          "candidateIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/candidateId" } },
          "familyId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/familyId" }, { "type": "null" }] },
          "action": { "enum": ["admit", "merge", "split", "reject", "quarantine", "release-from-quarantine", "compile", "accept", "supersede"] },
          "reasonCodes": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          },
          "explanation": { "type": "string", "minLength": 20, "maxLength": 3000 },
          "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } },
          "actor": { "type": "string", "minLength": 1, "maxLength": 200 },
          "occurredAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "previousEventHash": { "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }] }
        }
      }
    }
  }
}
