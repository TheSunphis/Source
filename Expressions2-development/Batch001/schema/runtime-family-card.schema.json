{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/runtime-family-card.schema.json",
  "title": "Koto Expressions2 complete runtime Full Family Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "family", "analyses", "integrity"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "const": "0.1.0-development" },
    "family": { "$ref": "family.schema.json" },
    "analyses": { "type": "array", "minItems": 1, "items": { "$ref": "form-analysis.schema.json" } },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["allPublishedFormsAnalyzed", "allAnalysisRefsResolved", "noPersonalState", "deviceTtsOnly"],
      "properties": {
        "allPublishedFormsAnalyzed": { "const": true },
        "allAnalysisRefsResolved": { "const": true },
        "noPersonalState": { "const": true },
        "deviceTtsOnly": { "const": true }
      }
    }
  }
}
