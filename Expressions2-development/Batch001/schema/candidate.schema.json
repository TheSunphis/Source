{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koto.invalid/expressions2/candidate.schema.json",
  "title": "Koto Expressions2 normalized clean-room candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "candidateId", "surface", "reading", "normalizedKey",
    "senseGlosses", "sourceEvidence", "classHypotheses", "signals",
    "normalization", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "$ref": "common.schema.json#/$defs/candidateId" },
    "surface": { "$ref": "common.schema.json#/$defs/japanese" },
    "reading": { "$ref": "common.schema.json#/$defs/reading" },
    "normalizedKey": { "type": "string", "minLength": 1, "maxLength": 500 },
    "senseGlosses": {
      "description": "May be empty when a source supports form/expression status but not a safe meaning; later gates must resolve meaning without fabricated filler.",
      "type": "array", "minItems": 0, "maxItems": 20, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "sourceEvidence": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "common.schema.json#/$defs/evidence" }
    },
    "classHypotheses": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/familyClass" }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multiword", "fixedness", "productiveSlots", "formulaic", "pragmaticFunction",
        "dictionaryExpressionTag", "corpusHitCount"
      ],
      "properties": {
        "multiword": { "type": "boolean" },
        "fixedness": { "type": "number", "minimum": 0, "maximum": 1 },
        "productiveSlots": { "type": "integer", "minimum": 0, "maximum": 20 },
        "formulaic": { "type": "boolean" },
        "pragmaticFunction": { "type": "boolean" },
        "dictionaryExpressionTag": { "type": "boolean" },
        "corpusHitCount": { "type": "integer", "minimum": 0 }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelineVersion", "unicodeForm", "sourceRecordIds", "inputDigest"],
      "properties": {
        "pipelineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "unicodeForm": { "const": "NFC" },
        "sourceRecordIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "inputDigest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
