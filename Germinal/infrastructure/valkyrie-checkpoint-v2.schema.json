{
  "$id": "germinal-valkyrie-checkpoint-v2-slot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "expression"
          ]
        },
        "required": [
          "reasonCode"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "const": "submitted"
          }
        }
      },
      "then": {
        "required": [
          "expression"
        ]
      }
    }
  ],
  "properties": {
    "expression": {
      "type": "object"
    },
    "reasonCode": {
      "type": "string"
    },
    "slotId": {
      "enum": [
        "V1-W002-C01-001",
        "V1-W002-C01-002",
        "V1-W002-C01-003",
        "V1-W002-C01-004",
        "V1-W002-C01-005"
      ]
    },
    "status": {
      "enum": [
        "submitted",
        "abstained",
        "failed"
      ]
    }
  },
  "required": [
    "slotId",
    "status"
  ],
  "title": "Germinal Valkyrie checkpoint slot",
  "type": "object"
}
