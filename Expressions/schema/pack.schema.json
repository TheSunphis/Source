{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheSunphis/Source/blob/main/Expressions/schema/pack.schema.json",
  "title": "Koto Expressions pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "schemaVersion", "familyCount", "families"],
  "properties": {
    "packId": { "type": "string", "pattern": "^pack-[0-9]{3,}$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "familyCount": { "type": "integer", "minimum": 1 },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "expression-family.schema.json" }
    }
  }
}
