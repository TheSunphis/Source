{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheSunphis/Source/blob/main/Expressions/schema/editorial-decision.schema.json",
  "title": "Koto expression editorial decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "decision",
    "familyId",
    "mergedCandidates",
    "relatedCandidatesNotMerged",
    "reviewedAt",
    "reviewer",
    "finalPublicationApproved"
  ],
  "properties": {
    "decisionId": { "type": "string", "pattern": "^decision:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "decision": { "const": "merge-into-reviewed-family" },
    "familyId": { "type": "string", "pattern": "^expression:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "mergedCandidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^candidate:jmdict:[0-9]+$" }
    },
    "relatedCandidatesNotMerged": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "reason"],
        "properties": {
          "candidateId": { "type": "string", "pattern": "^candidate:jmdict:[0-9]+$" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 100 },
    "finalPublicationApproved": { "const": false }
  }
}
