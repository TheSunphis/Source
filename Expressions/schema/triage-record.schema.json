{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheSunphis/Source/blob/main/Expressions/schema/triage-record.schema.json",
  "title": "Koto automated expression-candidate triage record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidateId",
    "sourceSequence",
    "automatedScore",
    "automatedRoute",
    "suggestedCategory",
    "clusterHint",
    "signals",
    "riskFlags",
    "editorialAssignment"
  ],
  "properties": {
    "candidateId": { "type": "string", "pattern": "^candidate:jmdict:[0-9]+$" },
    "sourceSequence": { "type": "integer", "minimum": 1 },
    "automatedScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "automatedRoute": {
      "enum": ["priority-family-review", "standard-family-review", "specialist-review", "low-priority-review"]
    },
    "suggestedCategory": {
      "enum": ["social-formula", "request-or-response", "interaction-management", "grammar-pattern", "idiom", "proverb", "other-expression"]
    },
    "clusterHint": { "type": "string", "minLength": 1, "maxLength": 200 },
    "signals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "riskFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "editorialAssignment": {
      "type": ["string", "null"],
      "pattern": "^expression:[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
